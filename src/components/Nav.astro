---
// Sticky site header: name mark, section links, search (opens the command
// palette), theme toggle, and a full-width menu panel on small screens.
// Links use /#id so they work from case-study pages too.
import ThemeToggle from "./ThemeToggle.astro";

const items = [
  { id: "work", label: "Work" },
  { id: "open-source", label: "Open source" },
  { id: "experience", label: "Experience" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
---

<header class="nav" data-nav>
  <div class="wrap bar">
    <a class="mark" href={isHome ? "#top" : "/"} aria-label="Zaman Sheikh, home">
      <span>Zaman Sheikh</span><span class="mark-dot" aria-hidden="true"></span>
    </a>

    <nav class="primary" aria-label="Primary">
      <ul>
        {items.map((it) => <li><a href={`/#${it.id}`} data-section={it.id}>{it.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <button class="search" type="button" data-palette-open aria-haspopup="dialog" aria-label="Search the site">
        <svg viewBox="0 0 20 20" aria-hidden="true"
          ><circle cx="8.75" cy="8.75" r="5.25" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path
            d="m12.75 12.75 3.75 3.75"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path></svg
        >
        <span class="search-label" aria-hidden="true">Search</span>
        <kbd data-shortcut aria-hidden="true">⌘K</kbd>
      </button>
      <ThemeToggle />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-btn>
        <span class="sr-only" data-menu-label>Open menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="panel" id="menu-panel" data-menu-panel>
    <nav class="wrap" aria-label="Menu">
      <ul class="panel-links">
        {
          items.map((it, i) => (
            <li>
              <a href={`/#${it.id}`}>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                {it.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="btn panel-search" type="button" data-palette-open aria-haspopup="dialog">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
          ><circle cx="8.75" cy="8.75" r="5.25" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path
            d="m12.75 12.75 3.75 3.75"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path></svg
        >
        Search projects and links
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease);
  }
  .nav[data-scrolled],
  .nav[data-open] {
    border-bottom-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }

  /* name mark: the red dot is the full stop */
  .mark {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    min-height: 44px;
    padding-block: 13px;
    font: 650 1.125rem / 1 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }
  .mark-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
  }

  .primary {
    margin-left: auto;
  }
  .primary ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .primary a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 999px;
    transition: color 0.2s;
  }
  .primary a::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .primary a:hover,
  .primary a[aria-current="true"] {
    color: var(--ink);
  }
  .primary a:hover::after,
  .primary a[aria-current="true"]::after {
    transform: scaleX(1);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 8px 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--muted);
    font: 500 var(--t-small) / 1 var(--font-body);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .search:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .search svg {
    width: 16px;
    height: 16px;
  }
  .search kbd {
    padding: 5px 7px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-2);
    font: 500 0.6875rem / 1 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .burger {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .burger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }
  .menu-btn[aria-expanded="true"] .burger span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .burger span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .panel {
    display: none;
  }

  /* the palette needs JS */
  :global(html:not(.js)) .search {
    display: none;
  }

  @media (max-width: 899px) {
    .primary {
      display: none;
    }
    .tools {
      margin-left: auto;
    }
    .search {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .search-label,
    .search kbd {
      display: none;
    }
    :global(html.js) .menu-btn {
      display: inline-grid;
    }

    /* with JS: a full-height sheet under the bar, toggled by the menu button */
    :global(html.js) .panel[data-open] {
      display: block;
      position: fixed;
      inset: 68px 0 0 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--paper);
      padding-block: 8px 40px;
    }
    /* without JS: the links sit in a simple wrapping row under the bar */
    :global(html:not(.js)) .panel {
      display: block;
      border-top: 1px solid var(--line);
    }
    :global(html:not(.js)) .panel-links {
      display: flex;
      flex-wrap: wrap;
      column-gap: 18px;
    }
    :global(html:not(.js)) .panel-links a {
      min-height: 44px;
      padding-block: 0;
      align-items: center;
      border: 0;
      font: 500 var(--t-small) / 1 var(--font-body);
      letter-spacing: 0;
    }
    :global(html:not(.js)) .panel-search,
    :global(html:not(.js)) .num {
      display: none;
    }
  }

  .panel-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel-links a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-height: 60px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
    font: 600 1.75rem / 1.1 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .panel-links a:hover {
    color: var(--accent);
  }
  .num {
    min-width: 2ch;
    font: 500 var(--t-micro) / 1 var(--font-mono);
    color: var(--muted);
    letter-spacing: 0.08em;
  }
  .panel-search {
    margin-top: 28px;
    width: 100%;
    justify-content: center;
    min-height: 48px;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .panel[data-open] {
      animation: panel-in 0.28s var(--ease);
    }
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]")!;
  const btn = header.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const btnLabel = header.querySelector<HTMLElement>("[data-menu-label]")!;
  const panel = header.querySelector<HTMLElement>("[data-menu-panel]")!;

  // Shortcut label: ⌘K on Apple platforms, Ctrl K elsewhere
  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
  const isMac = /mac|iphone|ipad|ipod/i.test(nav.userAgentData?.platform || navigator.platform || navigator.userAgent);
  if (!isMac) header.querySelectorAll("[data-shortcut]").forEach((k) => (k.textContent = "Ctrl K"));
  header
    .querySelectorAll("[data-palette-open]")
    .forEach((b) => b.setAttribute("aria-keyshortcuts", isMac ? "Meta+K" : "Control+K"));

  // Bottom border once the page has scrolled
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header.toggleAttribute("data-scrolled", window.scrollY > 4);
      ticking = false;
    });
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const outside = () =>
    [document.querySelector("main"), document.querySelector("body > footer")].filter(Boolean) as HTMLElement[];
  const isOpen = () => panel.hasAttribute("data-open");
  function setMenu(open: boolean, restoreFocus = true) {
    if (open === isOpen()) return;
    panel.toggleAttribute("data-open", open);
    header.toggleAttribute("data-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btnLabel.textContent = open ? "Close menu" : "Open menu";
    document.documentElement.style.overflow = open ? "hidden" : "";
    outside().forEach((el) => (el.inert = open));
    if (open) panel.querySelector<HTMLElement>("a")?.focus();
    else if (restoreFocus) btn.focus();
  }
  btn.addEventListener("click", () => setMenu(!isOpen()));
  panel.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false, false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      e.preventDefault();
      setMenu(false);
    }
  });
  // Close if focus leaves the header while the menu is open
  header.addEventListener("focusout", (e) => {
    const next = e.relatedTarget as Node | null;
    if (isOpen() && next && !header.contains(next)) setMenu(false, false);
  });
  matchMedia("(min-width: 900px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false, false);
  });

  // Search buttons open the command palette
  header.querySelectorAll("[data-palette-open]").forEach((b) =>
    b.addEventListener("click", () => {
      setMenu(false, false);
      window.dispatchEvent(new Event("palette:open"));
    }),
  );

  // Mark the section in view (home page only)
  const links = header.querySelectorAll<HTMLAnchorElement>(".primary a[data-section]");
  const sections = [...links]
    .map((a) => document.getElementById(a.dataset.section!))
    .filter((s): s is HTMLElement => !!s);
  if (sections.length && "IntersectionObserver" in window) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => visible.set(en.target.id, en.isIntersecting));
        const current = sections.find((s) => visible.get(s.id))?.id;
        links.forEach((a) => {
          if (a.dataset.section === current) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        });
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
