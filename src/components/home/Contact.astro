---
import { profile, links } from "../../data/profile";

const social = [
  { label: "GitHub", href: links.github, handle: "zamansheikh" },
  { label: "LinkedIn", href: links.linkedin, handle: "in/zamansheikh" },
  { label: "X", href: links.x, handle: "@zamansheikh_404" },
  { label: "YouTube", href: links.youtube, handle: "@zaman-sheikh" },
  { label: "CV", href: profile.cv, handle: "PDF" },
];
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>Contact</p>
    <h2 id="contact-title" class="contact-title" data-reveal>Have something hard to build?</h2>
    <p class="lede contact-lede" data-reveal>
      Tell me what it needs to do and where it is stuck.
    </p>

    <div class="email-row" data-reveal>
      <a class="email" href={`mailto:${profile.email}`} data-email>{profile.email}</a>
      <button type="button" class="btn copy" data-copy={profile.email}>
        <span data-copy-label>Copy</span>
      </button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </div>

    <ul class="social" data-reveal>
      {
        social.map((s) => (
          <li>
            <a href={s.href}>
              <span class="social-label">{s.label}</span>
              <span class="social-handle">{s.handle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact-title {
    margin-top: 18px;
    font-size: clamp(2.4rem, 1.4rem + 4.6vw, 5.6rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 14ch;
  }
  .contact-lede { margin-top: 22px; }
  .email-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: clamp(32px, 4vw, 48px); }
  .email {
    font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em;
    font-size: clamp(1.15rem, 0.8rem + 1.9vw, 2.4rem);
    color: var(--ink); text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 6px;
    overflow-wrap: anywhere;
  }
  .email:hover { color: var(--accent); }
  .copy { min-height: 44px; font-family: var(--font-mono); font-weight: 500; }
  .copy.is-done { border-color: var(--accent); color: var(--accent); }

  .social {
    list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (min-width: 760px) { .social { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .social li { border-bottom: 1px solid var(--line); }
  .social a {
    display: flex; flex-direction: column; gap: 2px;
    padding: 16px 0; min-height: 44px;
    text-decoration: none;
  }
  .social-label { font-weight: 600; }
  .social-handle { font: 500 var(--t-micro) / 1.4 var(--font-mono); color: var(--muted); }
  .social a:hover .social-label { color: var(--accent); }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>("[data-copy-label]")!;
    const status = btn.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
    const email = btn.parentElement?.querySelector<HTMLElement>("[data-email]");
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy!;
      try {
        await navigator.clipboard.writeText(text);
        label.textContent = "Copied";
        btn.classList.add("is-done");
        if (status) status.textContent = "Email address copied to clipboard";
      } catch {
        // clipboard blocked: select the address so the visitor can copy it by hand
        if (email) {
          const range = document.createRange();
          range.selectNodeContents(email);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        label.textContent = "Selected";
        if (status) status.textContent = "Email address selected, press Control or Command C to copy";
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = "Copy";
        btn.classList.remove("is-done");
      }, 2200);
    });
  });
</script>
