---
// One case study per entry in src/content/work. Order (for previous / next)
// matches the home grid: `order` ascending, then newest year first.
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/profile";

type Entry = CollectionEntry<"work">;

export async function getStaticPaths() {
  const all = (await getCollection("work")).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
  );
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: all.length > 1 ? all[(i - 1 + all.length) % all.length] : undefined,
      next: all.length > 1 ? all[(i + 1) % all.length] : undefined,
    },
  }));
}

interface Props {
  entry: Entry;
  prev?: Entry;
  next?: Entry;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const categoryLabel: Record<Entry["data"]["category"], string> = {
  product: "Product",
  client: "Client work",
  "open-source": "Open source",
  app: "App",
  experiment: "Experiment",
};
const statusLabel: Record<Entry["data"]["status"], string> = {
  live: "Live",
  shipped: "Shipped",
  "in-progress": "In progress",
  archived: "Archived",
};
const linkLabel = { live: "Live", store: "Store", repo: "Repo", package: "Package", docs: "Docs" } as const;
const linkList = (Object.keys(linkLabel) as (keyof typeof linkLabel)[])
  .filter((k) => d.links[k])
  .map((k) => ({ key: k, label: linkLabel[k], href: d.links[k]! }));

// readable text on the project colour (used when there is no cover)
function inkOn(hex: string) {
  const m = hex.replace("#", "").match(/^([0-9a-f]{3}|[0-9a-f]{6})$/i);
  if (!m) return "#ffffff";
  const h = m[1].length === 3 ? [...m[1]].map((c) => c + c).join("") : m[1];
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4));
  const L = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return L > 0.4 ? "#131416" : "#ffffff";
}

// gallery: justified rows. Each item grows in proportion to its aspect ratio,
// so every image in a row ends up the same height whatever its shape.
const gallery = d.gallery.map((g) => ({ ...g, ratio: +(g.src.width / g.src.height).toFixed(4) }));
// a set of phone screenshots reads best as an even row of devices instead
const phones = gallery.length > 1 && gallery.every((g) => g.ratio < 0.8);
const phoneCols = Math.min(gallery.length, gallery.length === 6 ? 3 : 5);

const title = `${d.title} · ${profile.name}`;
// social card: the cover cropped to 1200x630, else the site card
const ogImage = d.cover
  ? (await getImage({ src: d.cover, width: 1200, height: 630, fit: "cover", position: "top", format: "jpg", quality: 82 })).src
  : undefined;
---

<Base title={title} description={d.summary} type="article" image={ogImage}>
  <article class="case">
    <header class="wrap head">
      <a class="back" href="/#work">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        All work
      </a>
      <p class="eyebrow">{categoryLabel[d.category]} · {d.year}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>

      <dl class="meta">
        <div>
          <dt>Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd class="status">
            <span class:list={["dot", d.status === "live" ? "dot-live" : "dot-quiet"]} aria-hidden="true"></span>
            {statusLabel[d.status]}
            {d.metric && <span class="metric">{d.metric}</span>}
          </dd>
        </div>
        <div class="meta-stack">
          <dt>Stack</dt>
          <dd>
            <ul class="chips">{d.stack.map((s) => <li class="chip">{s}</li>)}</ul>
          </dd>
        </div>
        {
          linkList.length > 0 && (
            <div class="meta-links">
              <dt>Links</dt>
              <dd>
                <ul class="links">
                  {linkList.map((l, i) => (
                    <li>
                      <a class:list={["btn", "btn-sm", i === 0 && "btn-primary"]} href={l.href} rel="noopener" target="_blank">
                        {l.label}
                        <svg viewBox="0 0 12 12" aria-hidden="true">
                          <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="wrap">
      {
        d.cover ? (
          <figure class="cover">
            <Image
              src={d.cover}
              alt={`${d.title}, project cover`}
              widths={[640, 960, 1280, 1600, 2400].filter((w) => w <= d.cover!.width)}
              sizes="(min-width: 1200px) 1120px, calc(100vw - 2 * clamp(16px, 4vw, 40px))"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        ) : (
          <div class="cover cover-block" style={`--c:${d.color};--on:${inkOn(d.color)}`} aria-hidden="true">
            <span>{d.title.trim().charAt(0)}</span>
          </div>
        )
      }
    </div>

    <div class="wrap body">
      <div class="prose">
        <Content />
      </div>
      {
        d.highlights.length > 0 && (
          <aside class="highlights" aria-labelledby="highlights-title">
            <h2 id="highlights-title" class="eyebrow">Highlights</h2>
            <ol>
              {d.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    {
      gallery.length > 0 && (
        <section class="wrap gallery-wrap" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="gallery-title">Gallery</h2>
          <div class:list={["gallery", phones && "gallery-phones"]} style={phones ? `--cols:${phoneCols}` : undefined}>
            {gallery.map((g, i) => (
              <figure class="shot" style={`--r:${g.ratio}`}>
                <a href={g.src.src} class="shot-frame" aria-label={`Open ${g.caption ?? `screenshot ${i + 1}`} full size`}>
                  <Image
                    src={g.src}
                    alt={g.caption ?? `${d.title} screenshot ${i + 1}`}
                    widths={[360, 540, 720, 1080, 1600].filter((w) => w <= g.src.width)}
                    sizes={`(min-width: 1200px) ${Math.min(1120, Math.round(g.ratio * 400))}px, ${Math.min(100, Math.round(g.ratio * 50))}vw`}
                    loading="lazy"
                  />
                </a>
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
            {gallery.length > 1 && <span class="gallery-fill" aria-hidden="true" />}
          </div>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav class="wrap pager" aria-label="More work">
          {prev && (
            <a class="pager-link prev" href={`/work/${prev.id}/`} rel="prev">
              <span class="eyebrow">Previous</span>
              <span class="pager-title">{prev.data.title}</span>
              <span class="pager-meta">{categoryLabel[prev.data.category]} · {prev.data.year}</span>
            </a>
          )}
          {next && (
            <a class="pager-link next" href={`/work/${next.id}/`} rel="next">
              <span class="eyebrow">Next</span>
              <span class="pager-title">{next.data.title}</span>
              <span class="pager-meta">{categoryLabel[next.data.category]} · {next.data.year}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .case {
    padding-bottom: var(--section);
  }

  /* ---------- header ---------- */
  .head {
    padding-top: clamp(20px, 4vw, 48px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    margin-left: -2px;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
  }
  .back svg {
    width: 16px;
    height: 16px;
    transition: transform 0.25s var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }
  .back:hover svg {
    transform: translateX(-3px);
  }
  .head .eyebrow {
    margin-top: clamp(28px, 5vw, 56px);
  }
  h1 {
    margin-top: 14px;
    max-width: 16ch;
    font-size: clamp(2.6rem, 1.5rem + 4.6vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .head .lede {
    margin-top: clamp(18px, 2.5vw, 28px);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
    max-width: 52ch;
  }

  .meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.6fr) minmax(0, 1.4fr);
    gap: 24px 32px;
    margin: clamp(36px, 5vw, 64px) 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .meta > div {
    min-width: 0;
  }
  dt {
    font: 500 var(--t-micro) / 1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 12px 0 0;
    font-size: var(--t-small);
    color: var(--ink);
    line-height: 1.5;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }
  .status .dot {
    margin-right: -2px;
  }
  .dot-quiet {
    background: var(--line-strong);
  }
  .metric {
    flex-basis: 100%;
    color: var(--muted);
  }
  .chips,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links {
    gap: 8px;
  }
  .btn-sm {
    min-height: 44px;
    padding: 0 16px;
  }
  .btn-sm svg {
    width: 12px;
    height: 12px;
    margin-left: -2px;
  }

  @media (max-width: 1000px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .meta-stack,
    .meta-links {
      grid-column: 1 / -1;
    }
  }

  /* ---------- cover ---------- */
  .cover {
    margin: clamp(32px, 5vw, 64px) 0 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }
  .cover :global(img) {
    width: 100%;
    height: auto;
  }
  .cover-block {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    background: var(--c);
    color: var(--on);
    border-color: transparent;
  }
  .cover-block span {
    font: 600 clamp(6rem, 3rem + 14vw, 16rem) / 1 var(--font-display);
    letter-spacing: -0.06em;
    opacity: 0.92;
  }

  /* ---------- body ---------- */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 68ch) minmax(220px, 300px);
    justify-content: space-between;
    gap: 48px 64px;
    margin-top: clamp(48px, 7vw, 96px);
  }
  .body:not(:has(.highlights)) {
    grid-template-columns: minmax(0, 68ch);
  }
  .highlights {
    align-self: start;
    position: sticky;
    top: 100px;
    padding-top: 18px;
    border-top: 1px solid var(--ink);
  }
  .highlights h2 {
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
  }
  .highlights ol {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: hl;
  }
  .highlights li {
    counter-increment: hl;
    display: grid;
    grid-template-columns: 28px 1fr;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .highlights li::before {
    content: counter(hl, decimal-leading-zero);
    font: 500 var(--t-micro) / 1.9 var(--font-mono);
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
    .highlights {
      position: static;
      order: -1;
    }
  }

  /* prose: the markdown body */
  .prose {
    min-width: 0;
    color: var(--ink-2);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(> :first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(table),
  .prose :global(figure) {
    margin: 0 0 1.25em;
  }
  .prose :global(h2) {
    margin: 2.2em 0 0.7em;
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    color: var(--ink);
  }
  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    font-size: var(--t-h3);
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .prose :global(h4) {
    margin: 1.6em 0 0.5em;
    font: 600 var(--t-micro) / 1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .prose :global(strong) {
    color: var(--ink);
    font-weight: 650;
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin: 0.4em 0;
    padding-left: 0.3em;
  }
  .prose :global(ul > li::marker) {
    content: "–  ";
    color: var(--muted);
  }
  .prose :global(ol > li::marker) {
    font: 500 0.85em var(--font-mono);
    color: var(--muted);
  }
  .prose :global(blockquote) {
    padding: 2px 0 2px 1.1em;
    border-left: 2px solid var(--accent);
    color: var(--ink);
    font-size: 1.125rem;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.12em 0.4em;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper-2);
    color: var(--ink);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid var(--line);
  }
  .prose :global(img) {
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--t-small);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--ink);
    font-weight: 600;
  }

  /* ---------- gallery ---------- */
  .gallery-wrap {
    margin-top: clamp(64px, 9vw, 120px);
  }
  .gallery-title {
    font-size: var(--t-h2);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .gallery {
    --h: 280px; /* target row height: two 16:9 shots share a row */
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(20px, 2.4vw, 28px) clamp(12px, 1.6vw, 20px);
  }
  .shot {
    flex: var(--r) 1 calc(var(--r) * var(--h));
    min-width: 0;
    max-width: 100%;
    margin: 0;
  }
  /* keeps a short last row from stretching to full width */
  .gallery-fill {
    flex: 6 1 0;
    height: 0;
  }
  .shot-frame {
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--paper-2);
    transition: border-color 0.2s;
  }
  .shot-frame:hover {
    border-color: var(--line-strong);
  }
  .shot-frame :global(img) {
    width: 100%;
    height: auto;
  }
  figcaption {
    margin-top: 10px;
    font-size: var(--t-micro);
    font-family: var(--font-mono);
    line-height: 1.5;
    color: var(--muted);
  }
  .gallery-phones {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }
  .gallery-phones .gallery-fill {
    display: none;
  }
  @media (max-width: 900px) {
    .gallery {
      --h: 220px;
    }
    .gallery-phones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .gallery {
      --h: 160px;
    }
    .gallery-phones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- previous / next ---------- */
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(72px, 10vw, 140px);
  }
  .pager-link {
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: 140px;
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.25s var(--ease);
  }
  .pager-link:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .pager-link.next {
    text-align: right;
  }
  .pager-link.next:only-child {
    grid-column: 2;
  }
  .pager-title {
    font: 600 var(--t-h3) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pager-meta {
    font-size: var(--t-small);
    color: var(--muted);
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-link.next {
      text-align: left;
    }
    .pager-link.next:only-child {
      grid-column: auto;
    }
    .pager-link {
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pager-link:hover {
      transform: none;
    }
  }
</style>
