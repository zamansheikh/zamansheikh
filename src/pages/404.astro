---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
---

<Base title={`Page not found · ${profile.name}`} description="This page does not exist. Head back to the home page or browse the work." noindex>
  <section class="wrap nf" aria-labelledby="nf-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="nf-title">Nothing ships at this address.</h1>
    <p class="lede">The page may have moved when the site was rebuilt, or the link has a typo. Everything that exists is one click away.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Back to home</a>
      <a class="btn" href="/#work">Browse the work</a>
    </div>
    <p class="hint">
      Or <button type="button" class="hint-btn" data-open-palette>search projects and links</button><span class="kbd-hint">
        <kbd data-key>⌘K</kbd></span
      >.
    </p>
    <div class="grid" aria-hidden="true">
      {Array.from({ length: 21 }, (_, i) => <span class:list={["cell", (i === 10 || i === 17) && "on", i === 3 && "on-2"]} />)}
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    align-content: center;
    gap: 22px;
    min-height: min(78vh, 760px);
    padding-block: clamp(64px, 10vw, 140px);
  }
  h1 {
    max-width: 14ch;
    font-size: var(--t-hero);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .actions .btn {
    min-height: 48px;
  }
  .hint {
    color: var(--muted);
    font-size: var(--t-small);
  }
  :global(html:not(.js)) .hint {
    display: none;
  }
  .hint-btn {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .hint-btn:hover {
    text-decoration-color: currentColor;
  }
  .kbd-hint {
    margin-left: 6px;
  }
  @media (hover: none) {
    .kbd-hint {
      display: none;
    }
  }
  kbd {
    padding: 3px 7px;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 6px;
    background: var(--card);
    color: var(--ink-2);
    font-size: 0.75rem;
  }
  /* a quiet slice of the contribution graph: mostly empty days */
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 14px);
    gap: 4px;
    margin-top: 28px;
  }
  .cell {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--g0);
  }
  .cell.on {
    background: var(--g2);
  }
  .cell.on-2 {
    background: var(--g4);
  }
</style>

<script>
  const isMac = /mac|iphone|ipad|ipod/i.test(navigator.platform || navigator.userAgent);
  if (!isMac) document.querySelectorAll("[data-key]").forEach((k) => (k.textContent = "Ctrl K"));
  document.querySelector("[data-open-palette]")?.addEventListener("click", () => window.dispatchEvent(new Event("palette:open")));
</script>
