---
import { profile, links } from "../data/profile";
import { live } from "../data/live";

const year = new Date().getFullYear();
const synced = new Date(live.generatedAt);
const hasSync = !Number.isNaN(synced.getTime()) && synced.getUTCFullYear() > 1970;
const syncedLabel = hasSync
  ? synced.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })
  : "";

const elsewhere = [
  { label: "GitHub", href: links.github },
  { label: "LinkedIn", href: links.linkedin },
  { label: "X", href: links.x },
  { label: "YouTube", href: links.youtube },
  { label: "Instagram", href: links.instagram },
  { label: "Silifton", href: links.silifton },
  { label: "CV", href: profile.cv, note: "PDF" },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="id">
        <p class="name">{profile.name}</p>
        <p class="role">{profile.role} · {profile.headline}</p>
        <p class="line">Founder of Silifton. Building from Bangladesh.</p>
      </div>
      <nav aria-label="Elsewhere">
        <ul class="links">
          {
            elsewhere.map((l) => {
              const external = l.href.startsWith("http");
              return (
                <li>
                  <a href={l.href} {...(external ? { rel: "me noopener" } : { type: "application/pdf" })}>
                    <span>{l.label}</span>
                    {l.note ? (
                      <span class="note">{l.note}</span>
                    ) : (
                      <svg viewBox="0 0 12 12" aria-hidden="true">
                        <path d="M3.5 8.5 8.5 3.5M4.5 3.5h4v4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <p>© {year} {profile.name}</p>
      {hasSync && <p>Data synced <time datetime={live.generatedAt}>{syncedLabel}</time></p>}
      <p class="mail"><a href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: clamp(48px, 7vw, 88px) 28px;
    background: var(--paper);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 40px;
    align-items: start;
  }
  .name {
    font: 600 var(--t-h2) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .role {
    margin-top: 14px;
    color: var(--ink-2);
    font-size: var(--t-small);
  }
  .line {
    margin-top: 4px;
    color: var(--muted);
    font-size: var(--t-small);
  }
  .links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s;
  }
  .links a:hover {
    color: var(--accent);
    border-bottom-color: currentColor;
  }
  .links svg {
    width: 12px;
    height: 12px;
    color: var(--muted);
    transition: transform 0.25s var(--ease), color 0.2s;
  }
  .links a:hover svg {
    color: currentColor;
    transform: translate(2px, -2px);
  }
  .note {
    font: 500 0.6875rem / 1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin-top: clamp(40px, 6vw, 72px);
    font: 400 var(--t-micro) / 1.6 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .mail {
    margin-left: auto;
  }
  .mail a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
  }
  .mail a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .top {
      grid-template-columns: 1fr;
    }
    .mail {
      margin-left: 0;
      flex-basis: 100%;
      overflow-wrap: anywhere;
    }
  }
</style>
